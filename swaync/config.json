{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "control-center-width": 380,
  "control-center-height": 620,
  "control-center-margin-top": 8,
  "control-center-margin-right": 14,
  "notification-window-width": 360,
  "timeout": 4,
  "timeout-low": 3,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "keyboard-shortcuts": true,
  "hide-on-clear": true,
  "hide-on-action": true,
  "image-visibility": "when-available",
  "widgets": [
    "title",
    "dnd",
    "mpris",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "notifications",
      "clear-all-button": true,
      "button-text": "clear"
    },
    "dnd": {
      "text": "do not disturb"
    },
    "mpris": {
      "image-size": 64,
      "image-radius": 8,
      "blacklist": [
        "playerctld"
      ]
    }
  }
}
