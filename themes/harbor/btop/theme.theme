# Harbor · dusk over water — btop
#
# Linked in as ~/.config/btop/themes/current.theme by theme-apply.sh (btop.conf
# says color_theme = "current" once and never changes).
#
# Same role assignments as the rest of the desktop: amber frames the boxes,
# lit amber is the live readout, and gradients climb amber -> orange -> red
# (readout -> warn -> urgent: the hoodie, the lamplit pavement, the hair) so
# a hot CPU reads like a loud cava bar or a critical bar module. At rest the
# whole screen is teal-black and amber — lamplight on the railing at dusk.

theme[main_bg]="#0e1a20"
theme[main_fg]="#efe6d3"
theme[title]="#e0ab5a"
theme[hi_fg]="#f6c870"
theme[selected_bg]="#172730"
theme[selected_fg]="#e0ab5a"
theme[inactive_fg]="#4f7a84"
theme[graph_text]="#62939f"
theme[meter_bg]="#243a44"
theme[proc_misc]="#7dd3a6"

# Box outlines — amber is the frame color everywhere in this desktop.
theme[cpu_box]="#e0ab5a"
theme[mem_box]="#e0ab5a"
theme[net_box]="#e0ab5a"
theme[proc_box]="#e0ab5a"
theme[div_line]="#243a44"

# Temperature: lit amber -> lamplit orange -> red at the top.
theme[temp_start]="#f6c870"
theme[temp_mid]="#f27c35"
theme[temp_end]="#eb4030"

# CPU load.
theme[cpu_start]="#f6c870"
theme[cpu_mid]="#f27c35"
theme[cpu_end]="#eb4030"

# Free / cached / available / used memory.
theme[free_start]="#243a44"
theme[free_mid]="#7dd3a6"
theme[free_end]="#7dd3a6"
theme[cached_start]="#243a44"
theme[cached_mid]="#f6c870"
theme[cached_end]="#f6c870"
theme[available_start]="#243a44"
theme[available_mid]="#f27c35"
theme[available_end]="#f27c35"
theme[used_start]="#243a44"
theme[used_mid]="#e0ab5a"
theme[used_end]="#eb4030"

# Disk io.
theme[download_start]="#243a44"
theme[download_mid]="#f6c870"
theme[download_end]="#f6c870"
theme[upload_start]="#243a44"
theme[upload_mid]="#e0ab5a"
theme[upload_end]="#e0ab5a"

# Process box gradient.
theme[process_start]="#f6c870"
theme[process_mid]="#f27c35"
theme[process_end]="#eb4030"
