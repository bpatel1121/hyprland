// Harbor · dusk over water — fastfetch
//
// AMBER keys, as the bar's frame; the title prints in the cyan slot, which in
// this terminal is the SMOKE, not the readout — the readout is warm, so the
// slot convention bends there (see wezterm/colors.lua). The slots themselves
// are the same as every other theme's, so recolor-on-switch still works. The
// `colors` module at the bottom puts the actual palette on screen.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "arch",
        "padding": { "top": 1, "right": 3 },
        // SAME slots as the cyberpunk config — bright-magenta is the FRAME
        // slot, cyan the READOUT slot, in every dark theme's wezterm palette
        // (harbor's cyan slot holds the smoke instead; see the header).
        // Printed output then remaps to the right identity in BOTH directions
        // on SUPER+T (per-theme indexes remapped to the wrong hues).
        "color": { "1": "95", "2": "36" }
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys":  "95",   // frame slot -> #e0ab5a amber via the palette
            "title": "36"    // readout slot -> #82e0fa: here the smoke (launcher)
        }
    },

    "modules": [
        "break",
        { "type": "title", "keyWidth": 10 },
        "separator",

        { "type": "os",         "key": "󰣇 os     " },
        { "type": "kernel",     "key": "󰌢 kernel " },
        { "type": "uptime",     "key": "󰅐 uptime " },
        { "type": "packages",   "key": "󰮯 pkgs   " },
        { "type": "shell",      "key": "󰆍 shell  " },
        { "type": "wm",         "key": "󰕮 wm     " },
        { "type": "terminal",   "key": "󰆍 term   " },
        { "type": "font",       "key": "󰛖 font   " },

        "break",
        { "type": "cpu",        "key": "󰻠 cpu    " },
        { "type": "gpu",        "key": "󰢮 gpu    " },
        { "type": "memory",     "key": "󰍛 memory " },
        { "type": "disk",       "key": "󰋊 disk   " },

        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 2 },
        "break"
    ]
}
