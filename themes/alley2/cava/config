# Generated · Material You (matugen) — cava
#
# Deliberately NOT a pink->cyan gradient. That blend is exactly what made this
# theme read as cotton candy, and it's banned everywhere else here too.
#
# Instead cava reads as a VU meter, which also obeys the theme's core rule that
# color means state: quiet is cyan (the "live readout" color, same as waybar's
# instruments), loud climbs into amber, peaks hit red. Pink stays out of it —
# pink is frame and light in this theme, not data.

[general]
framerate = 60
autosens = 1
overshoot = 20
bars = 0            # 0 = auto-fit the terminal width
bar_width = 2
bar_spacing = 1

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average

[color]
background = '#1a110e'      # no0
gradient = 1
gradient_count = 6
gradient_color_1 = '#e6beae'    # cy0  — quiet
gradient_color_2 = '#e6beae'    # cy0
gradient_color_3 = '#30F291'    # gr0  — rising
gradient_color_4 = '#F2D230'    # ye0  — loud
gradient_color_5 = '#F2D230'    # ye0
gradient_color_6 = '#ffb4ab'    # re0  — peak

[smoothing]
noise_reduction = 45
