// Generated · Material You (matugen) — fastfetch
//
// Same frame/content split as waybar: PINK keys, CYAN values. The `colors`
// module at the bottom puts the actual palette on screen, which is the whole
// point of a fetch in a screenshot.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "arch",
        "padding": { "top": 1, "right": 3 },
        // pi0 pink then cy0 cyan — the logo carries the same two colors as the bar
        "color": { "1": "38;2;255;181;150", "2": "38;2;230;190;174" }
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys":  "38;2;255;181;150",   // pi0
            "title": "38;2;230;190;174"    // cy0
        }
    },

    "modules": [
        "break",
        { "type": "title", "keyWidth": 10 },
        "separator",

        { "type": "os",         "key": "󰣇 os     " },
        { "type": "kernel",     "key": "󰌢 kernel " },
        { "type": "uptime",     "key": "󰅐 uptime " },
        { "type": "packages",   "key": "󰮯 pkgs   " },
        { "type": "shell",      "key": "󰆍 shell  " },
        { "type": "wm",         "key": "󰕮 wm     " },
        { "type": "terminal",   "key": "󰆍 term   " },
        { "type": "font",       "key": "󰛖 font   " },

        "break",
        { "type": "cpu",        "key": "󰻠 cpu    " },
        { "type": "gpu",        "key": "󰢮 gpu    " },
        { "type": "memory",     "key": "󰍛 memory " },
        { "type": "disk",       "key": "󰋊 disk   " },

        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 2 },
        "break"
    ]
}
