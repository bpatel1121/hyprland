# Glacier · frost — btop
#
# Linked in as ~/.config/btop/themes/current.theme by theme-apply.sh (btop.conf
# says color_theme = "current" once and never changes).
#
# Same role assignments as the rest of the desktop: ice cyan frames the boxes,
# white is the live readout, gradients climb white -> green/yellow -> red so a
# hot CPU reads like a loud cava bar or a critical bar module. Warm shows up
# only as state; at rest the whole screen is navy, white and cyan.

theme[main_bg]="#0b1838"
theme[main_fg]="#e6eefc"
theme[title]="#5bd7fa"
theme[hi_fg]="#e8f4ff"
theme[selected_bg]="#15295a"
theme[selected_fg]="#5bd7fa"
theme[inactive_fg]="#51578c"
theme[graph_text]="#7f8fbf"
theme[meter_bg]="#223b6e"
theme[proc_misc]="#7bd389"

# Box outlines — ice cyan is the frame color everywhere in this desktop.
theme[cpu_box]="#5bd7fa"
theme[mem_box]="#5bd7fa"
theme[net_box]="#5bd7fa"
theme[proc_box]="#5bd7fa"
theme[div_line]="#223b6e"

# Temperature: cool white -> yellow -> red at the top.
theme[temp_start]="#e8f4ff"
theme[temp_mid]="#e9c46a"
theme[temp_end]="#ff6b81"

# CPU load.
theme[cpu_start]="#e8f4ff"
theme[cpu_mid]="#7bd389"
theme[cpu_end]="#ff6b81"

# Free / cached / available / used memory.
theme[free_start]="#223b6e"
theme[free_mid]="#7bd389"
theme[free_end]="#7bd389"
theme[cached_start]="#223b6e"
theme[cached_mid]="#e8f4ff"
theme[cached_end]="#e8f4ff"
theme[available_start]="#223b6e"
theme[available_mid]="#e9c46a"
theme[available_end]="#e9c46a"
theme[used_start]="#223b6e"
theme[used_mid]="#5bd7fa"
theme[used_end]="#ff6b81"

# Disk io.
theme[download_start]="#223b6e"
theme[download_mid]="#e8f4ff"
theme[download_end]="#e8f4ff"
theme[upload_start]="#223b6e"
theme[upload_mid]="#5bd7fa"
theme[upload_end]="#5bd7fa"

# Process box gradient.
theme[process_start]="#e8f4ff"
theme[process_mid]="#e9c46a"
theme[process_end]="#ff6b81"
