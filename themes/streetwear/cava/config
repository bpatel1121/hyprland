# Streetwear · light — cava
#
# NOT the VU meter the other two themes draw. On paper there is no "lit"
# level to climb to, so the wave is the jacket's own print instead: quiet is
# navy (the readout ink), rising goes holographic pink, the peaks are the
# yellow tag — the three identity colors in the order the bar wears them. The
# tag's yellow can top a bar where it could never carry text: a bar is a fill.
# Red stays out of it; it is a state color, and sound level is not a state.

[general]
framerate = 60
autosens = 1
overshoot = 20
bars = 0            # 0 = auto-fit the terminal width
bar_width = 2
bar_spacing = 1

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average

[color]
background = '#fbf8f2'      # surface — the terminal's paper
gradient = 1
gradient_count = 6
gradient_color_1 = '#13202a'    # navy   — quiet (readout)
gradient_color_2 = '#13202a'    # navy
gradient_color_3 = '#d66676'    # pink   — rising (launcher)
gradient_color_4 = '#d66676'    # pink
gradient_color_5 = '#e9b92a'    # tag    — loud (frame)
gradient_color_6 = '#e9b92a'    # tag    — peak

[smoothing]
noise_reduction = 45
