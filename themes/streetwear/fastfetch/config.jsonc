// Streetwear · light — fastfetch
//
// Same frame/content split as the bar, printed: TAG-INK keys, NAVY values.
// The `colors` module at the bottom puts the actual palette on screen.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "arch",
        "padding": { "top": 1, "right": 3 },
        // ANSI palette INDEXES, not literal RGB, like the other two configs —
        // so already-printed output recolors live on SUPER+T. The slots
        // differ: bright magenta (95) is the holo pink here and normal yellow
        // (33) the tag ink — see wezterm/colors.lua for why the frame slot
        // moved. Pink body, tag-ink core: the sticker and the tag.
        "color": { "1": "95", "2": "33" }
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys":  "33",   // tag ink #8a6b0e — the frame, printed (the raw yellow is 1.7:1 on paper)
            "title": "36"    // the eyes #1e6f7c — navy readout IS the value color here, so the title takes the one cool accent
        }
    },

    "modules": [
        "break",
        { "type": "title", "keyWidth": 10 },
        "separator",

        { "type": "os",         "key": "󰣇 os     " },
        { "type": "kernel",     "key": "󰌢 kernel " },
        { "type": "uptime",     "key": "󰅐 uptime " },
        { "type": "packages",   "key": "󰮯 pkgs   " },
        { "type": "shell",      "key": "󰆍 shell  " },
        { "type": "wm",         "key": "󰕮 wm     " },
        { "type": "terminal",   "key": "󰆍 term   " },
        { "type": "font",       "key": "󰛖 font   " },

        "break",
        { "type": "cpu",        "key": "󰻠 cpu    " },
        { "type": "gpu",        "key": "󰢮 gpu    " },
        { "type": "memory",     "key": "󰍛 memory " },
        { "type": "disk",       "key": "󰋊 disk   " },

        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 2 },
        "break"
    ]
}
