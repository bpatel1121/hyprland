// Cyberpunk · Cybrcolors — fastfetch
//
// Same frame/content split as waybar: PINK keys, CYAN values. The `colors`
// module at the bottom puts the actual palette on screen, which is the whole
// point of a fetch in a screenshot.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "arch",
        "padding": { "top": 1, "right": 3 },
        // ANSI palette INDEXES, not literal RGB: bright-magenta is pi0 pink
        // and cyan is cy0 in the theme's wezterm palette — and because these
        // are indexes, already-printed output recolors live on SUPER+T.
        "color": { "1": "95", "2": "36" }
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys":  "95",   // bright magenta -> pi0 pink via the palette
            "title": "36"    // cyan -> cy0
        }
    },

    "modules": [
        "break",
        { "type": "title", "keyWidth": 10 },
        "separator",

        { "type": "os",         "key": "󰣇 os     " },
        { "type": "kernel",     "key": "󰌢 kernel " },
        { "type": "uptime",     "key": "󰅐 uptime " },
        { "type": "packages",   "key": "󰮯 pkgs   " },
        { "type": "shell",      "key": "󰆍 shell  " },
        { "type": "wm",         "key": "󰕮 wm     " },
        { "type": "terminal",   "key": "󰆍 term   " },
        { "type": "font",       "key": "󰛖 font   " },

        "break",
        { "type": "cpu",        "key": "󰻠 cpu    " },
        { "type": "gpu",        "key": "󰢮 gpu    " },
        { "type": "memory",     "key": "󰍛 memory " },
        { "type": "disk",       "key": "󰋊 disk   " },

        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 2 },
        "break"
    ]
}
