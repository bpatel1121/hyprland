// Graphite · light — fastfetch
//
// Same frame/content split as the bar, in pencil: PENCIL keys, INK values,
// one VIOLET title. The `colors` module at the bottom puts the actual palette
// on screen — mostly greys, one hue, which is the whole point of this one.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "arch",
        "padding": { "top": 1, "right": 3 },
        // ANSI palette INDEXES, not literal RGB, like the other configs — so
        // already-printed output recolors live on SUPER+T. Black (30) is the
        // INK here (wezterm/colors.lua puts `frame` in the black slot) and
        // magenta (35) is the violet readout. Ink body, violet core: the
        // sketch and its one eye.
        "color": { "1": "30", "2": "35" }
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys":  "34",   // hard pencil #5c5054 — the frame is ink, the same weight as the values, so the keys step DOWN a pencil weight instead of changing hue (the blue slot is a grey in this scheme)
            "title": "35"    // the violet eye #8a4f96 — the readout, and the one hue on the page
        }
    },

    "modules": [
        "break",
        { "type": "title", "keyWidth": 10 },
        "separator",

        { "type": "os",         "key": "󰣇 os     " },
        { "type": "kernel",     "key": "󰌢 kernel " },
        { "type": "uptime",     "key": "󰅐 uptime " },
        { "type": "packages",   "key": "󰮯 pkgs   " },
        { "type": "shell",      "key": "󰆍 shell  " },
        { "type": "wm",         "key": "󰕮 wm     " },
        { "type": "terminal",   "key": "󰆍 term   " },
        { "type": "font",       "key": "󰛖 font   " },

        "break",
        { "type": "cpu",        "key": "󰻠 cpu    " },
        { "type": "gpu",        "key": "󰢮 gpu    " },
        { "type": "memory",     "key": "󰍛 memory " },
        { "type": "disk",       "key": "󰋊 disk   " },

        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 2 },
        "break"
    ]
}
