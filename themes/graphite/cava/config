# Graphite · light — cava
#
# NOT the VU meter the dark themes draw. On paper there is no "lit" level to
# climb to, so the wave is drawn in the page's own three weights instead:
# quiet is the VIOLET eye (the readout — a level is telemetry), rising goes
# through the lit violet (the launcher), and the peaks are INK (the frame) —
# the heaviest line in the sketch, which is what loud looks like in pencil.
# Red stays out of it; it is a state color, and sound level is not a state.

[general]
framerate = 60
autosens = 1
overshoot = 20
bars = 0            # 0 = auto-fit the terminal width
bar_width = 2
bar_spacing = 1

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average

[color]
background = '#f6f3f5'      # surface — the terminal's paper
gradient = 1
gradient_count = 6
gradient_color_1 = '#8a4f96'    # violet  — quiet (readout)
gradient_color_2 = '#8a4f96'    # violet
gradient_color_3 = '#9c63a8'    # lit violet — rising (launcher)
gradient_color_4 = '#9c63a8'    # lit violet
gradient_color_5 = '#2b2427'    # ink     — loud (frame)
gradient_color_6 = '#2b2427'    # ink     — peak

[smoothing]
noise_reduction = 45
