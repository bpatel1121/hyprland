# Gruvbox · dark — btop
#
# Linked in as ~/.config/btop/themes/current.theme by theme-apply.sh (btop.conf
# says color_theme = "current" once and never changes).
#
# Same role assignments as the rest of the desktop: orange frames the boxes,
# aqua is the live readout, gradients climb aqua -> green/yellow -> red so a
# hot CPU reads like a loud cava bar or a critical waybar module.

theme[main_bg]="#1d2021"
theme[main_fg]="#ebdbb2"
theme[title]="#fe8019"
theme[hi_fg]="#8ec07c"
theme[selected_bg]="#282828"
theme[selected_fg]="#fe8019"
theme[inactive_fg]="#665c54"
theme[graph_text]="#928374"
theme[meter_bg]="#3c3836"
theme[proc_misc]="#b8bb26"

# Box outlines — orange is the frame color everywhere in this desktop.
theme[cpu_box]="#fe8019"
theme[mem_box]="#fe8019"
theme[net_box]="#fe8019"
theme[proc_box]="#fe8019"
theme[div_line]="#3c3836"

# Temperature: cool aqua -> yellow -> red at the top.
theme[temp_start]="#8ec07c"
theme[temp_mid]="#fabd2f"
theme[temp_end]="#fb4934"

# CPU load.
theme[cpu_start]="#8ec07c"
theme[cpu_mid]="#b8bb26"
theme[cpu_end]="#fb4934"

# Free / cached / available / used memory.
theme[free_start]="#3c3836"
theme[free_mid]="#b8bb26"
theme[free_end]="#b8bb26"
theme[cached_start]="#3c3836"
theme[cached_mid]="#8ec07c"
theme[cached_end]="#8ec07c"
theme[available_start]="#3c3836"
theme[available_mid]="#fabd2f"
theme[available_end]="#fabd2f"
theme[used_start]="#3c3836"
theme[used_mid]="#fe8019"
theme[used_end]="#fb4934"

# Disk io.
theme[download_start]="#3c3836"
theme[download_mid]="#8ec07c"
theme[download_end]="#8ec07c"
theme[upload_start]="#3c3836"
theme[upload_mid]="#fe8019"
theme[upload_end]="#fe8019"

# Process box gradient.
theme[process_start]="#8ec07c"
theme[process_mid]="#fabd2f"
theme[process_end]="#fb4934"
