# Gruvbox · dark — cava
#
# Same VU-meter semantics as cyberpunk — color means state, not decoration:
# quiet sits in aqua (the readout color), rising goes green, loud climbs into
# yellow, peaks hit red. Orange stays out of the data for the same reason pink
# did: it's the frame color, not a level.

[general]
framerate = 60
autosens = 1
overshoot = 20
bars = 0            # 0 = auto-fit the terminal width
bar_width = 2
bar_spacing = 1

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average

[color]
background = '#1d2021'      # bg0_h
gradient = 1
gradient_count = 6
gradient_color_1 = '#8ec07c'    # aqua   — quiet
gradient_color_2 = '#8ec07c'    # aqua
gradient_color_3 = '#b8bb26'    # green  — rising
gradient_color_4 = '#fabd2f'    # yellow — loud
gradient_color_5 = '#fabd2f'    # yellow
gradient_color_6 = '#fb4934'    # red    — peak

[smoothing]
noise_reduction = 45
