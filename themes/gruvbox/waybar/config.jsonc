{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 0,
    "margin-top": 8,
    "margin-left": 14,
    "margin-right": 14,
    "modules-left": ["hyprland/workspaces", "mpris"],
    "modules-center": ["clock"],
    "modules-right": ["custom/updates", "custom/aur", "temperature", "pulseaudio", "network", "bluetooth", "battery", "tray"],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },

    // The icons here used to be EMPTY strings, so {player_icon}/{status_icon}
    // rendered nothing and play-vs-pause was signalled only by the text going
    // one shade darker. Real glyphs now carry that difference, and the CSS adds
    // a glow on top: md-spotify / md-play when live, md-pause when not.
    //
    // position/length moved to the tooltip. At max-length 40 they were eating
    // the budget and truncating the artist away before ever showing.
    "mpris": {
        "interval": 1,
        "format": "{player_icon}  {title} · {artist}",
        "format-paused": "{status_icon}  {title} · {artist}",
        "player-icons": { "default": "󰐊", "spotify": "󰓇" },
        "status-icons": { "paused": "󰏤" },
        "max-length": 42,
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "tooltip-format": "{title} — {artist} ({album})  {position}/{length}"
    },

    "clock": {
        "format": "  {:%H:%M} ",
        "format-alt": "  {:%a %d %b} ",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    // Repo updates — Pac-Man glyph, Pac-Man yellow. Stays on screen at 0 and
    // grays out there; the .pending/.zero class comes from the script, which is
    // why this is return-type json. Needs `checkupdates` from pacman-contrib.
    // signal 8: refresh instantly after an update with: pkill -SIGRTMIN+8 waybar
    "custom/updates": {
        "exec": "$HOME/.config/hypr/scripts/waybar-updates.sh pacman",
        "return-type": "json",
        "interval": 1800,
        "signal": 8,
        "on-click": "wezterm start -- sh -c 'sudo pacman -Syu; pkill -SIGRTMIN+8 waybar; read -p done'"
    },

    // AUR updates via yay — party popper, because "yay". Longer interval than
    // the repo check: it goes over the network to the AUR RPC (the script caps
    // that with a timeout so a dead link can't wedge the bar).
    // signal 9: pkill -SIGRTMIN+9 waybar
    "custom/aur": {
        "exec": "$HOME/.config/hypr/scripts/waybar-updates.sh aur",
        "return-type": "json",
        "interval": 3600,
        "signal": 9,
        "on-click": "wezterm start -- sh -c 'yay -Sua; pkill -SIGRTMIN+9 waybar; read -p done'"
    },

    // Silent watchdog: renders NOTHING below 80° (empty format hides it),
    // appears pulsing red only when the machine is actually hot.
    "temperature": {
        "critical-threshold": 80,
        "format": "",
        "format-critical": " {temperatureC}°"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " muted",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    // Live throughput readout — the HUD part. Wifi details move to the tooltip.
    "network": {
        "interval": 2,
        "format-wifi": "  {bandwidthDownBytes}  {bandwidthUpBytes}",
        "format-ethernet": "  {bandwidthDownBytes}  {bandwidthUpBytes}",
        "format-disconnected": " off",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)  {ipaddr}",
        "tooltip-format-ethernet": "{ifname}  {ipaddr}",
        "on-click": "wezterm start -- nmtui"
    },

    // Icon-only: connected = lit icon (device name in tooltip), off = hidden.
    "bluetooth": {
        "format": "",
        "format-connected": "",
        "format-off": "",
        "format-disabled": "",
        "tooltip-format-connected": "{device_alias}",
        "on-click": "wezterm start -- bluetoothctl"
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "states": { "warning": 30, "critical": 15 }
    },

    "tray": { "spacing": 8 }
}
