// Gruvbox · dark — fastfetch
//
// Same frame/content split as waybar: ORANGE keys, AQUA values. The `colors`
// module at the bottom puts the actual palette on screen.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "arch",
        "padding": { "top": 1, "right": 3 },
        // ANSI palette INDEXES, not literal RGB, so already-printed output
        // recolors live on SUPER+T. Gruvbox's 16 has no orange slot: keys ride
        // bright-yellow (#fabd2f amber — arguably MORE CRT); values are
        // bright-blue, which IS #83a598 exactly.
        "color": { "1": "93", "2": "94" }
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys":  "93",   // bright yellow -> #fabd2f amber
            "title": "94"    // bright blue -> #83a598, exact
        }
    },

    "modules": [
        "break",
        { "type": "title", "keyWidth": 10 },
        "separator",

        { "type": "os",         "key": "󰣇 os     " },
        { "type": "kernel",     "key": "󰌢 kernel " },
        { "type": "uptime",     "key": "󰅐 uptime " },
        { "type": "packages",   "key": "󰮯 pkgs   " },
        { "type": "shell",      "key": "󰆍 shell  " },
        { "type": "wm",         "key": "󰕮 wm     " },
        { "type": "terminal",   "key": "󰆍 term   " },
        { "type": "font",       "key": "󰛖 font   " },

        "break",
        { "type": "cpu",        "key": "󰻠 cpu    " },
        { "type": "gpu",        "key": "󰢮 gpu    " },
        { "type": "memory",     "key": "󰍛 memory " },
        { "type": "disk",       "key": "󰋊 disk   " },

        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 2 },
        "break"
    ]
}
