# Gruvbox · dark
font=JetBrainsMono Nerd Font 11
# Translucent so the `mako-blur` layer rule in hyprland.lua has something to
# frost — at full opacity the blur is invisible.
background-color=#282828CC
text-color=#ebdbb2
# Orange border — the frame color, same rule as waybar's islands.
border-color=#fe8019
border-size=2
border-radius=12
progress-color=over #8ec07c
padding=12,16
margin=12
default-timeout=4000
max-visible=5
anchor=top-right
width=360
height=140
icons=1
max-icon-size=48
format=<b>%s</b>\n%b

# Click actions
on-button-left=invoke-default-action
on-button-right=dismiss
on-button-middle=exec makoctl dismiss --all

# Stack notifications from the same app
group-by=app-name

[urgency=low]
border-color=#8ec07c
text-color=#928374
default-timeout=3000

[urgency=high]
border-color=#fb4934
text-color=#fb4934
default-timeout=0

# Spotify notifications get a green border + bigger album art
[app-name=Spotify]
border-color=#b8bb26
max-icon-size=64
default-timeout=6000

# Do Not Disturb — toggle with: makoctl mode -t dnd
[mode=dnd]
invisible=1
