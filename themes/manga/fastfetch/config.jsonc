// Manga · light — fastfetch
//
// Same frame/content split as the bar, in print: MID-INK keys, INK values,
// an INK title. Greys only — the `colors` module at the bottom puts the actual
// palette on screen, which is where the terminal's six muted hues show, and
// nowhere else on this page.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "arch",
        "padding": { "top": 1, "right": 3 },
        // ANSI palette INDEXES, not literal RGB, like the other configs — so
        // already-printed output recolors live on SUPER+T. Black (30) is the
        // INK here (wezterm/colors.lua puts `frame` in the black slot) and
        // white (37) is the mid ink. Ink body, mid-ink core: a printed logo at
        // two weights.
        "color": { "1": "30", "2": "37" }
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys":  "37",   // the mid ink #4a4a4a (launcher) — the frame is ink, the same weight as the values, so the keys step DOWN a weight instead of changing hue (the white slot is the mid ink in this scheme)
            "title": "95"    // the FRAME slot: ink #111111 — the identity sits in bright magenta in every theme, and here the identity is the ink
        }
    },

    "modules": [
        "break",
        { "type": "title", "keyWidth": 10 },
        "separator",

        { "type": "os",         "key": "󰣇 os     " },
        { "type": "kernel",     "key": "󰌢 kernel " },
        { "type": "uptime",     "key": "󰅐 uptime " },
        { "type": "packages",   "key": "󰮯 pkgs   " },
        { "type": "shell",      "key": "󰆍 shell  " },
        { "type": "wm",         "key": "󰕮 wm     " },
        { "type": "terminal",   "key": "󰆍 term   " },
        { "type": "font",       "key": "󰛖 font   " },

        "break",
        { "type": "cpu",        "key": "󰻠 cpu    " },
        { "type": "gpu",        "key": "󰢮 gpu    " },
        { "type": "memory",     "key": "󰍛 memory " },
        { "type": "disk",       "key": "󰋊 disk   " },

        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 2 },
        "break"
    ]
}
