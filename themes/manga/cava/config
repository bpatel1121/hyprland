# Manga · light — cava
#
# NOT the VU meter the dark themes draw. On a printed page there is no "lit"
# level to climb to, so the wave is drawn in the page's own weights instead:
# quiet is PENCIL (dim), rising goes through the MID INK (the launcher's
# weight), and the peaks are INK (the frame) — the heaviest line on the page,
# which is what loud looks like in print. Darker as it gets louder, like every
# ramp in this theme. Pure black stays out of it; it is the urgent weight,
# and sound level is not a state.

[general]
framerate = 60
autosens = 1
overshoot = 20
bars = 0            # 0 = auto-fit the terminal width
bar_width = 2
bar_spacing = 1

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average

[color]
background = '#f5f5f5'      # surface — the terminal's page
gradient = 1
gradient_count = 6
gradient_color_1 = '#858585'    # pencil   — quiet (dim)
gradient_color_2 = '#858585'    # pencil
gradient_color_3 = '#4a4a4a'    # mid ink  — rising (launcher)
gradient_color_4 = '#4a4a4a'    # mid ink
gradient_color_5 = '#111111'    # ink      — loud (frame)
gradient_color_6 = '#111111'    # ink      — peak

[smoothing]
noise_reduction = 45
